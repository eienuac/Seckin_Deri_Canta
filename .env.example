# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Seçkin Çanta

# Payload CMS → Supabase PostgreSQL (NOT localhost)
# Dashboard → Connect → Connection string (URI)
# Prefer Session pooler (port 5432) for Payload on Windows/IPv4:
#   postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Or direct (may require IPv6):
#   postgresql://postgres:[YOUR_DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Do NOT append ?sslmode=... — SSL is configured in payload.config.ts for Supabase hosts.
DATABASE_URL=
PAYLOAD_SECRET=change-me-to-a-long-random-string
PAYLOAD_CMS_URL=http://localhost:3000
PAYLOAD_API_KEY=
CRON_SECRET=
SYNC_WEBHOOK_SECRET=change-me-sync-webhook-secret

# Supabase API (Auth / RLS app data — separate from Payload schema)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment (iyzico)
PAYMENT_PROVIDER=iyzico
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Admin — comma-separated storefront (Supabase) emails that can open /app-admin
# Example: ADMIN_EMAILS=you@gmail.com,admin@seckincanta.com
ADMIN_EMAILS=admin@seckincanta.com

# Media
NEXT_PUBLIC_PAYLOAD_MEDIA_URL=http://localhost:3000
